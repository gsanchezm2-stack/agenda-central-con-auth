# Copie este archivo como .env y reemplace los valores. Nunca suba .env al repositorio.
# Base de datos en la nube (MongoDB Atlas). Incluya el nombre de la base antes del "?".
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/agenda_central?retryWrites=true&w=majority
PORT=5000
# Autenticación: clave para firmar los tokens (use un valor largo y aleatorio, distinto en cada entorno)
JWT_SECRET=cambie-esto-por-un-texto-largo-y-aleatorio
# Usuario administrador que crea "npm run seed" si todavía no existe ningún usuario
ADMIN_USUARIO=admin
ADMIN_CLAVE=CambieEstaClave123
